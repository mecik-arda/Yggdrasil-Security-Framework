# Yggdrasil Security Framework - Environment Variables
# Copy this file to .env and change the values.

# The secret key for Flask session signing.
# Generate a secure random string (e.g., python -c 'import secrets; print(secrets.token_hex(16))')
SECRET_KEY=yggdrasil-dev-key-1234

# Admin password to login to the framework
ADMIN_PASSWORD=yggdrasil2026

# Host binding
HOST=127.0.0.1
