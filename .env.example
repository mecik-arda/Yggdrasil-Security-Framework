# Yggdrasil Security Framework - Environment Variables
# Copy this file to .env and change the values.

# The secret key for Flask session signing.
# 1. Flask Secret Key (Required for sessions, CSRF, etc.)
# Replace this with a highly random string in production!
SECRET_KEY=change-me-please-1a2b3c4d5e

# 2. Administrator Password (Required to login)
# This is the password you will use to access the dashboard.
ADMIN_PASSWORD=change-me-please-2026

# Host binding
HOST=127.0.0.1
